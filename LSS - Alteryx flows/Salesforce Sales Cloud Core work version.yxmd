          <Properties>
            <Configuration>
              <Passwords />
              <File FileFormat="23" RecordLimit="">odbc:DRIVER={ODBC Driver 17 for SQL Server};DATABASE=salesforce backups;SERVER=NUSCLEVPDBAMP02;Trusted_Connection=yes|||select dbo.OpportunityTeamMember.OpportunityId,
	dbo.OpportunityTeamMember.TeamMemberRole,
	dbo.[User].Business_Unit__c,
	dbo.[User].FederationIdentifier,
	dbo.[User].IsActive,
	dbo.[User].IsPortalEnabled,
	dbo.[User].Level_1__c,
	dbo.[User].Level_2__c,
	dbo.[User].Level_3__c,
	dbo.[User].Level_4__c,
	dbo.[User].Level_5__c,
	dbo.[User].Level_6__c,
	dbo.[User].Name as FullName,
	dbo.[User].Team_Role__c,
	dbo.[User].Title,
	dbo.[User].UserType,
	dbo.[User].User__c,
	dbo.Profile.Name as ProfileName,
	dbo.OpportunityTeamMember.UserId as TeamMemberUserID 
from dbo.OpportunityTeamMember 
	inner join dbo.[User] on dbo.OpportunityTeamMember.UserId = dbo.[User].Id 
	inner join dbo.Profile on dbo.[User].ProfileId = dbo.Profile.Id</File>
