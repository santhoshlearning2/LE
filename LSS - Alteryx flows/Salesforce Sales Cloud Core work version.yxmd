              <File FileFormat="23" RecordLimit="">odbc:DRIVER={ODBC Driver 17 for SQL Server};DATABASE=salesforce backups;SERVER=NUSCLEVPDBAMP02;Trusted_Connection=yes|||select dbo.OpportunityFeed.Body,
	dbo.OpportunityFeed.CommentCount,
	dbo.OpportunityFeed.CreatedById,
	dbo.OpportunityFeed.CreatedDate,
	dbo.OpportunityFeed.LikeCount,
	dbo.OpportunityFeed.ParentId,
	dbo.OpportunityFeed.Type,
	dbo.Profile.Name as ProfileName,
	dbo.[User].Id as UserId,
	dbo.[User].Business_Unit__c,
	dbo.[User].FederationIdentifier,
	dbo.[User].IsActive,
	dbo.[User].IsPortalEnabled,
	dbo.[User].Level_1__c,
	dbo.[User].Level_2__c,
	dbo.[User].Level_3__c,
	dbo.[User].Level_4__c,
	dbo.[User].Level_5__c,
