	dbo.[User].Title,
	dbo.[User].User__c,
	dbo.[User].UserType,
	dbo.[User].Team_Role__c,
	dbo.OpportunityFeed.Id 
from dbo.OpportunityFeed 
	inner join dbo.[User] on dbo.OpportunityFeed.CreatedById = dbo.[User].Id 
	inner join dbo.Profile on dbo.[User].ProfileId = dbo.Profile.Id</File>
